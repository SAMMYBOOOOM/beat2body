# ============================================================
# beat2body — .gitignore
# ============================================================

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Editors / IDEs ----------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.ipr
*.iws
out/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
MANIFEST
*.manifest
*.spec

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version
.conda/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints
# Local Colab helper notebooks (may hold tokens); the project uses scripts, not notebooks
*.ipynb

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json
wandb/
# keep wandb config if you want, otherwise ignored above
!wandb/settings

# ---------- ML / training artifacts ----------
checkpoints/
ckpt/
runs/
logs/
lightning_logs/
outputs/
wandb/
mlruns/
*.ckpt
*.pt
*.pth
*.onnx
*.h5
*.pb
*.safetensors
*.bin

# ---------- Project data (large binaries) ----------
# Source videos — never commit
2d/raw_video/**/*.mp4
2d/raw_video/**/*.mov
2d/raw_video/**/*.avi
2d/raw_video/**/*.mkv
2d/raw_video/**/*.webm

# Extracted frames — regenerable
2d/frames/**/*.jpg
2d/frames/**/*.png

# Extracted audio — regenerable
2d/audio/**/*.wav
2d/audio/**/*.mp3
2d/audio/**/*.flac

# Processed keypoints / features — regenerate from video
2d/keypoints/**/*.npz
2d/keypoints/**/*.npy
2d/keypoints/**/*.json
2d/features/**/*.npy
2d/features/**/*.npz
2d/features/**/*.pkl
2d/features/contact/
2d/features/floor/

# Sliding-window clips and their per-tool manifests — regenerable, published on Hugging Face
2d/clips/**/*.npz
2d/clips/**/*.npy
2d/clips/*/meta.csv
2d/clips/*/split.json
2d/clips/*/audio_stats*.json

# Dataset cards (python -m beat2body hf card) and rendered videos
2d/hf_cards/
renders/

# Model-generated videos and keypoints: published on Hugging Face (SizheZ03/beat2body-runs) at the same paths
reports/**/*.mp4
reports/**/*.npz
results/**/*.mp4
results/**/*.npz

# 2d/categories.json IS tracked: it fixes the genre -> embedding index mapping,
# so a run on a subset of genres that rewrites it shows up in `git status`.

# ---------- Keep the folder skeleton ----------
# Empty dirs aren't tracked; these files force the structure.
# Add a .gitkeep to each data folder so `git clone` reproduces layout.
!2d/raw_video/**/.gitkeep
!2d/raw_video/**/.gitkeep
!2d/frames/.gitkeep
!2d/keypoints/**/.gitkeep
!2d/audio/**/.gitkeep
!2d/features/**/.gitkeep
!2d/clips/**/.gitkeep

# ---------- Misc ----------
*.log
*.tmp
*.bak
*.orig
*.rej
.DS_Store
dir.txt